# PIN POINT REVIEW - 환경 설정
# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.  (.env 는 git 에 올리지 않습니다)

# ── MariaDB 접속 정보 (setup_mariadb.sql 로 만든 계정)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pinpoint
DB_PASSWORD='여기에_비밀번호'
DB_NAME=pinpoint

# ── 화면 안내 메시지 쿠키 서명 키 (팀원마다 달라도 됨). 예시 값 그대로면 서버 시작 시 경고
#    만드는 법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── HTTPS 로 배포할 때만 1 (로컬 http 개발 중에는 0)
COOKIE_SECURE=0

# ── 이메일 인증 코드 (회원가입 · 비밀번호 변경)
#    MAIL_HOST 를 비워 두면 개발 모드: 메일 대신 화면과 서버 콘솔에 인증 코드를 보여 줌
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=1
# 0 이면 인증 코드 확인을 끔 (발표 시연 등)
EMAIL_VERIFICATION=1
