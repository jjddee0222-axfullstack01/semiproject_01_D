# PIN POINT REVIEW - 환경 설정
# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.  (.env 는 git 에 올리지 않습니다)

# ── MariaDB 접속 정보 (setup_mariadb.sql 로 만든 계정)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pinpoint
DB_PASSWORD='여기에_비밀번호'
DB_NAME=pinpoint
# ── (선택) DB 접속 주소를 한 줄로 지정. 값이 있으면 위의 DB_* 대신 이 주소를 사용
#    예) Aiven MySQL:  mysql+pymysql://avnadmin:비밀번호@호스트:포트/defaultdb?charset=utf8mb4&ssl_ca=/etc/secrets/ca.pem
#    예) Railway MySQL: mysql+pymysql://사용자:비밀번호@호스트:포트/railway?charset=utf8mb4  (docs/10_deployment.md 4장)
#    mysql:// 로 시작하는 주소는 드라이버가 달라 동작하지 않으므로 mysql+pymysql:// 로 씁니다
#    로컬 MariaDB 를 쓸 때는 비워 둡니다
DATABASE_URL=

# ── 화면 안내 메시지 쿠키 서명 키 (팀원마다 달라도 됨). 예시 값 그대로면 서버 시작 시 경고
#    만드는 법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── HTTPS 로 배포할 때만 1 (로컬 http 개발 중에는 0)
COOKIE_SECURE=0

# ── 이메일 인증 코드 (회원가입 · 비밀번호 변경)
#    MAIL_HOST 를 비워 두면 개발 모드: 메일 대신 화면과 서버 콘솔에 인증 코드를 보여 줌
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=1
# 0 이면 인증 코드 확인을 끔 (발표 시연 등)
EMAIL_VERIFICATION=1
#    COOKIE_SECURE=1(운영)인데 MAIL_HOST 가 비어 있으면 인증 코드를 화면에 보여 주지 않고 발송을 거부함 (서버 시작 시 경고)

# ── 시도 횟수 제한 (비워 두면 기본값). 발표장·강의실처럼 여러 사람이 같은 와이파이를 쓰면 IP 기준 값을 늘리세요
#    값 뒤에 주석을 붙이지 말고 숫자만 적습니다
LOGIN_MAX_FAILS=
LOGIN_LOCK_MINUTES=
LOGIN_IP_MAX_FAILS=
EMAIL_SEND_LIMIT_PER_EMAIL=
EMAIL_SEND_LIMIT_PER_IP=

# ── (선택) 내부 데이터 적재 API(/api/v1/internal/*) 키. 비워 두면 내부 API 는 모두 403 으로 막힘
#    쓸 때는 긴 무작위 값:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#    요청 헤더 X-Internal-Key 에 같은 값을 넣어 호출
INTERNAL_API_KEY=

# ※ 서버 시간대(TZ=Asia/Seoul)는 이 파일에 넣어도 적용되지 않습니다 (서버 시작 뒤에 읽기 때문).
#    배포 화면의 환경 변수나 서버 설정으로 지정하세요 (docs/10_deployment.md 4장)
