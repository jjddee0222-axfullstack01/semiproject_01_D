# PIN POINT REVIEW - 환경 설정
# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.  (.env 는 git 에 올리지 않습니다)

# ── MariaDB 접속 정보 (setup_mariadb.sql 로 만든 계정)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pinpoint
DB_PASSWORD='여기에_비밀번호'
DB_NAME=pinpoint

# ── 화면 안내 메시지 쿠키 서명 키 (아무 긴 문자열, 팀원마다 달라도 됨)
SECRET_KEY=change-this-to-a-long-random-string

# ── HTTPS 로 배포할 때만 1 (로컬 http 개발 중에는 0)
COOKIE_SECURE=0
